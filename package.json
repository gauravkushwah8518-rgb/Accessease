{
  "name": "accessease",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Universal web accessibility toolkit: dyslexia-friendly reading, text-to-speech, voice commands and color-blindness previews in one embeddable widget.",
  "license": "MIT",
  "scripts": {
    "start": "serve . -l 3000",
    "build": "node scripts/build-widget.cjs",
    "build:widget": "node scripts/build-widget.cjs",
    "check": "node scripts/check-syntax.cjs && node scripts/check-assets.cjs",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "serve": "^14.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
